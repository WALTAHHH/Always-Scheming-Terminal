exports[`digest redesign v2 — layout, truncation, escaping > HTML snapshot — 3-story sample renders Variant A (grouped) 1`] = `
"<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>Your weekly watchlist digest</title><style>
body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;}
/* Neutralise client auto-detected links (Apple Mail date/address/phone
   detectors) so the postal address + meta dates stay primary/muted instead of
   blue-underlined. Gmail's iOS/Android app injects its own auto-link styling
   that no CSS can override; see the .c-addr span markup for the best-effort
   containment there. */
a[x-apple-data-detectors]{color:inherit !important;text-decoration:none !important;font-size:inherit !important;font-family:inherit !important;font-weight:inherit !important;line-height:inherit !important;}
.u{text-decoration:underline !important;-webkit-text-decoration:underline !important;}
.c-addr{color:#4a4a55 !important;}
.gmail-hide{color:inherit !important;text-decoration:none !important;}
@media only screen and (max-width:480px){
.h1{font-size:20px !important;line-height:26px !important;}
.px{padding-left:16px !important;padding-right:16px !important;}
.btn{display:block !important;width:100% !important;}
.btn a{display:block !important;text-align:center !important;}
.hide-m{display:none !important;}
}
@media (prefers-color-scheme: light){
.c-page{background:#f4f5f7 !important;}
.c-card{background:#ffffff !important;}
.c-txt{color:#1a1a1a !important;}
.c-mut{color:#5b6270 !important;}
.c-acc{color:#0e7490 !important;}
.c-brand{color:#047857 !important;}
.c-brd{border-color:#e2e4e7 !important;}
.c-brdtop{border-top-color:#e2e4e7 !important;}
.c-brd-bot{border-bottom-color:#e2e4e7 !important;}
.c-tag{border-color:#c5cad1 !important;color:#5b6270 !important;}
.c-addr{color:#9a9aa5 !important;}
.c-head{border-bottom-color:#047857 !important;}
.c-cta{background:#0e7490 !important;}
.c-cta-txt{color:#ffffff !important;}
.chip-mint{background:#cde4dd !important;}
.chip-gold{background:#f0ddce !important;}
.chip-pink{background:#ecd2ef !important;}
.chip-muted{background:#e1e3e6 !important;}
.chip-txt{color:#1a1a1a !important;}
}
</style></head>
<body class="c-page" bgcolor="#0a0a0f" style="margin:0;padding:0;background:#0a0a0f;">
<div style="display:none;max-height:0;max-width:0;opacity:0;overflow:hidden;font-size:1px;line-height:1px;color:#0a0a0f;mso-hide:all;">SAMPLE — Acme Games acquires Pixel Forge for $120M in a cash-and-stock deal. Also: Northstar Interactive, Cobalt Studios.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0a0a0f" class="c-page" style="background:#0a0a0f;">
<tr><td align="center" style="padding:20px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="c-txt" style="width:100%;max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#d4d4d4;">
<tr><td class="px c-page c-head" bgcolor="#0a0a0f" style="padding:14px 24px;background:#0a0a0f;border-bottom:2px solid #6decb9;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:12px;letter-spacing:.02em;color:#d4d4d4;white-space:nowrap;"><span class="c-brand" style="color:#6decb9;font-weight:700;">Always Scheming Terminal</span></td><td align="right" class="c-mut" style="white-space:nowrap;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:10px;letter-spacing:.06em;color:#9ca3af;padding-left:8px;">WEEKLY DIGEST</td></tr></table></td></tr>
<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:18px 24px 0;background:#0a0a0f;"><p class="h1 c-txt" style="margin:0;font-size:22px;line-height:28px;font-weight:700;color:#d4d4d4;">3 updates across 3 companies this week</p><p class="c-mut" style="margin:4px 0 0;font-size:14px;line-height:20px;color:#9ca3af;">Week of Nov 16 &middot; most relevant first</p></td></tr>
<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:14px 24px 0;background:#0a0a0f;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn"><tr><td class="c-cta" bgcolor="#77c4d9" style="background:#77c4d9;border-radius:6px;"><a href="https://example.com/" class="c-cta-txt" style="display:inline-block;padding:11px 20px;font-size:15px;font-weight:700;line-height:18px;color:#0a0a0f;text-decoration:none;-webkit-text-decoration:none;">Open in Terminal &rarr;</a></td></tr></table></td></tr>
<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:12px 24px 0;background:#0a0a0f;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#1e1e1e" class="c-card c-brd" style="background:#1e1e1e;border:1px solid #2a2a2a;border-radius:8px;"><tr><td style="padding:12px 16px 6px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="font-size:16px;font-weight:700;line-height:22px;"><a href="https://example.com/?company=Acme%20Games" class="c-acc" style="color:#77c4d9;font-weight:700;text-decoration:none;-webkit-text-decoration:none;">Acme Games</a></td><td align="right"><span class="c-tag" style="display:inline-block;border:1px solid #444444;border-radius:3px;padding:1px 6px;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:10px;letter-spacing:.06em;color:#9ca3af;white-space:nowrap;">ACME</span></td></tr></table></td></tr><tr><td class="c-brdtop" style="padding:9px 16px 10px;border-top:1px solid #2a2a2a;"><p style="margin:0;font-size:16px;line-height:22px;"><a href="https://example.com/?sample=digest-1" target="_blank" rel="noopener noreferrer" class="c-txt" style="color:#d4d4d4;text-decoration:none;-webkit-text-decoration:none;font-weight:600;line-height:1.35;">SAMPLE — Acme Games acquires Pixel Forge for $120M in a cash-and-stock deal.<span class="c-acc" style="color:#77c4d9;white-space:nowrap;">&nbsp;&#8599;</span></a></p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:3px;"><tr><td class="c-mut" style="font-size:12px;line-height:16px;color:#9ca3af;vertical-align:middle;">The Game Business · Nov 17</td><td align="right" style="padding-left:8px;white-space:nowrap;vertical-align:middle;"><span class="chip-mint chip-txt" style="display:inline-block;vertical-align:1px;padding:1px 5px;border-radius:3px;background:#2e473d;color:#d4d4d4;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:16px;">ACQ</span></td></tr></table></td></tr></table></td></tr>
<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:12px 24px 0;background:#0a0a0f;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#1e1e1e" class="c-card c-brd" style="background:#1e1e1e;border:1px solid #2a2a2a;border-radius:8px;"><tr><td style="padding:12px 16px 6px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="font-size:16px;font-weight:700;line-height:22px;"><a href="https://example.com/?company=Northstar%20Interactive" class="c-acc" style="color:#77c4d9;font-weight:700;text-decoration:none;-webkit-text-decoration:none;">Northstar Interactive</a></td><td align="right"><span class="c-tag" style="display:inline-block;border:1px solid #444444;border-radius:3px;padding:1px 6px;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:10px;letter-spacing:.06em;color:#9ca3af;white-space:nowrap;">PRIVATE</span></td></tr></table></td></tr><tr><td class="c-brdtop" style="padding:9px 16px 10px;border-top:1px solid #2a2a2a;"><p style="margin:0;font-size:16px;line-height:22px;"><a href="https://example.com/?sample=digest-2" target="_blank" rel="noopener noreferrer" class="c-txt" style="color:#d4d4d4;text-decoration:none;-webkit-text-decoration:none;font-weight:600;line-height:1.35;">SAMPLE — Northstar Interactive raises a $45M Series B led by Horizon Ventures.<span class="c-acc" style="color:#77c4d9;white-space:nowrap;">&nbsp;&#8599;</span></a></p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:3px;"><tr><td class="c-mut" style="font-size:12px;line-height:16px;color:#9ca3af;vertical-align:middle;">PocketGamer.biz · Nov 16</td><td align="right" style="padding-left:8px;white-space:nowrap;vertical-align:middle;"><span class="chip-gold chip-txt" style="display:inline-block;vertical-align:1px;padding:1px 5px;border-radius:3px;background:#484119;color:#d4d4d4;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:16px;">RAISE</span></td></tr></table></td></tr></table></td></tr>
<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:12px 24px 0;background:#0a0a0f;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#1e1e1e" class="c-card c-brd" style="background:#1e1e1e;border:1px solid #2a2a2a;border-radius:8px;"><tr><td style="padding:12px 16px 6px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="font-size:16px;font-weight:700;line-height:22px;"><a href="https://example.com/?company=Cobalt%20Studios" class="c-acc" style="color:#77c4d9;font-weight:700;text-decoration:none;-webkit-text-decoration:none;">Cobalt Studios</a></td><td align="right"><span class="c-tag" style="display:inline-block;border:1px solid #444444;border-radius:3px;padding:1px 6px;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:10px;letter-spacing:.06em;color:#9ca3af;white-space:nowrap;">CBLT</span></td></tr></table></td></tr><tr><td class="c-brdtop" style="padding:9px 16px 10px;border-top:1px solid #2a2a2a;"><p style="margin:0;font-size:16px;line-height:22px;"><a href="https://example.com/?sample=digest-3" target="_blank" rel="noopener noreferrer" class="c-txt" style="color:#d4d4d4;text-decoration:none;-webkit-text-decoration:none;font-weight:600;line-height:1.35;">SAMPLE — Cobalt Studios cuts 80 roles as its live-service project winds down.<span class="c-acc" style="color:#77c4d9;white-space:nowrap;">&nbsp;&#8599;</span></a></p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:3px;"><tr><td class="c-mut" style="font-size:12px;line-height:16px;color:#9ca3af;vertical-align:middle;">GamesIndustry.biz · Nov 15</td><td align="right" style="padding-left:8px;white-space:nowrap;vertical-align:middle;"><span class="chip-pink chip-txt" style="display:inline-block;vertical-align:1px;padding:1px 5px;border-radius:3px;background:#442f44;color:#d4d4d4;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:16px;">LAYOFF</span></td></tr></table></td></tr></table></td></tr>

<tr><td class="px c-page" bgcolor="#0a0a0f" style="padding:24px 24px 28px;background:#0a0a0f;font-size:12px;line-height:18px;color:#9ca3af;"><p class="c-mut" style="margin:0;color:#9ca3af;">You get this because these companies are on your watchlist: Acme Games, Cobalt Studios, Northstar Interactive.</p><p class="c-mut" style="margin:8px 0 0;color:#9ca3af;"><a href="https://example.com/profile" class="c-acc u" style="color:#77c4d9;text-decoration:underline;-webkit-text-decoration:underline;">Manage watchlist</a> &middot; <a href="https://example.com/unsubscribe?token=xyz" class="c-acc u" style="color:#77c4d9;text-decoration:underline;-webkit-text-decoration:underline;">Unsubscribe</a></p></td></tr>
</table>
</td></tr>
</table>
